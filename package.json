{
  "name": "navcalc-app",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "author": "Kentaro Yamamoto (serkenn)",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkenn/Navigation-calculations.git"
  },
  "homepage": "https://navcalc.serken.tech/",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/third-party-notices.js && vite build && node scripts/fix-fallback.js",
    "preview": "vite preview",
    "serve": "node server.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "cap:sync": "npm run build && cap sync android",
    "cap:build": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.6.0",
    "@hono/node-server": "^2.1.6",
    "@lucide/svelte": "^1.69.0",
    "hono": "^4.13.16"
  },
  "build": {
    "appId": "com.navcalc.app",
    "productName": "NavCalc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ja-JP",
        "en-US"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.6"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "description": "船舶の航法計算 Web / デスクトップ / モバイルアプリ"
}
