{
  "name": "navcalc-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-fallback.js",
    "preview": "vite preview",
    "serve": "node server.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "cap:sync": "npm run build && cap sync android",
    "cap:build": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@hono/node-server": "^2.1.4",
    "@lucide/svelte": "^1.55.0",
    "hono": "^4.13.13"
  },
  "build": {
    "appId": "com.navcalc.app",
    "productName": "NavCalc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ja-JP",
        "en-US"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  }
}
