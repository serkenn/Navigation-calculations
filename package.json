{
  "name": "navcalc-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-fallback.js",
    "preview": "vite preview",
    "serve": "node server.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "cap:sync": "npm run build && cap sync android",
    "cap:build": "npm run build && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "lucide-svelte": "^0.469.0"
  },
  "build": {
    "appId": "com.navcalc.app",
    "productName": "NavCalc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "static/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ja-JP",
        "en-US"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "static/favicon.png"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.7.0",
    "vite": "^6.3.0"
  }
}
