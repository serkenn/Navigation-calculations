<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarText" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#334155"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#0F172A"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SheetBackground" Color="#F1F5F9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

    <!-- Input -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#3B82F6"/>

    <!-- Category Accent Colors -->
    <SolidColorBrush x:Key="Pilot1Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Pilot1Light" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Pilot2Accent" Color="#0891B2"/>
    <SolidColorBrush x:Key="Pilot2Light" Color="#ECFEFF"/>
    <SolidColorBrush x:Key="AstroAccent" Color="#D97706"/>
    <SolidColorBrush x:Key="AstroLight" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="SextantAccent" Color="#9333EA"/>
    <SolidColorBrush x:Key="SextantLight" Color="#FAF5FF"/>
    <SolidColorBrush x:Key="TimeArcAccent" Color="#16A34A"/>
    <SolidColorBrush x:Key="TimeArcLight" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="TimeCalcAccent" Color="#E11D48"/>
    <SolidColorBrush x:Key="TimeCalcLight" Color="#FFF1F2"/>
    <SolidColorBrush x:Key="ExamAccent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="ExamLight" Color="#EEF2FF"/>

    <!-- Result -->
    <SolidColorBrush x:Key="ResultPositive" Color="#16A34A"/>
    <SolidColorBrush x:Key="ResultNegative" Color="#DC2626"/>

    <!-- Separator -->
    <SolidColorBrush x:Key="Separator" Color="#E2E8F0"/>

</ResourceDictionary>
