<Window x:Class="NavCalc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NavCalc.App.ViewModels"
        Title="NavCalc - 航法計算"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="260"
                Background="{DynamicResource SidebarBackground}">
            <DockPanel>
                <!-- Sidebar Header -->
                <Border DockPanel.Dock="Top" Padding="16,16,16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="⚓"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NavCalc"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarText}"
                                       FontFamily="{StaticResource MainFont}"/>
                            <TextBlock Text="航法計算"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontFamily="{StaticResource MainFont}"/>
                        </StackPanel>
                        <!-- Theme Toggle -->
                        <Button DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="🌙"
                                FontSize="16"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource SidebarText}"
                                Cursor="Hand"
                                Click="ThemeToggle_Click"
                                Padding="6"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1"
                        Background="{DynamicResource SidebarHover}"/>

                <!-- Sidebar Categories -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                <StackPanel>
                                    <!-- Category Header -->
                                    <Button Style="{StaticResource SidebarCategoryHeader}"
                                            Command="{Binding ToggleCommand}">
                                        <DockPanel Width="220">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="▾"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="10">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotation" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Definition.NameJa}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SidebarText}"
                                                       TextTransform="Uppercase"/>
                                        </DockPanel>
                                    </Button>

                                    <!-- Calculator Items -->
                                    <ItemsControl ItemsSource="{Binding Calculators}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SidebarItem}"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="{Binding NameJa}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid>
            <!-- Welcome screen (when no calculator selected) -->
            <StackPanel x:Name="WelcomePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Visible">
                <TextBlock Text="⚓"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="NavCalc - 航法計算"
                           Style="{StaticResource HeaderText}"
                           HorizontalAlignment="Center"
                           FontSize="28"/>
                <TextBlock Text="左のサイドバーから計算機を選択してください"
                           Style="{StaticResource SubHeaderText}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Calculator Content -->
            <Grid x:Name="CalculatorPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="350"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="7*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- Input Panel -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBackground}"
                        Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentPresenter x:Name="InputContent"/>
                    </ScrollViewer>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="1"
                              Background="{DynamicResource Separator}"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- Result Panel -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SheetBackground}"
                        Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentPresenter x:Name="ResultContent"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
