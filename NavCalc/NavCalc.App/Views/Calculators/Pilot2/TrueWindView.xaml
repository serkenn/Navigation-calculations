<UserControl x:Class="NavCalc.App.Views.Calculators.Pilot2.TrueWindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="真風向・風速" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="True Wind" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <controls:NumberInputControl Label="相対風向" Value="{Binding RelativeDir}" Unit="°"/>
                    <controls:NumberInputControl Label="相対風速" Value="{Binding RelativeSpeed}" Unit="kn"/>
                    <controls:NumberInputControl Label="船首方位" Value="{Binding ShipCourse}" Unit="°"/>
                    <controls:NumberInputControl Label="船速" Value="{Binding ShipSpeed}" Unit="kn"/>
                </StackPanel>
            </Border>
            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource Pilot2Accent}" Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="真風向" Style="{StaticResource ResultLabel}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrueDir, StringFormat={}{0:F1}°}"
                               Style="{StaticResource ResultHighlight}" Foreground="{DynamicResource Pilot2Accent}"
                               HorizontalAlignment="Center"/>
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,8"/>
                    <TextBlock Text="真風速" Style="{StaticResource ResultLabel}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrueSpeed, StringFormat={}{0:F1} kn}"
                               Style="{StaticResource ResultHighlight}" Foreground="{DynamicResource Pilot2Accent}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
