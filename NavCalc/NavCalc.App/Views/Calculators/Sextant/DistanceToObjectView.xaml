<UserControl x:Class="NavCalc.App.Views.Calculators.Sextant.DistanceToObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="物標距離" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="Distance to Object" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <CheckBox Content="地理学的視距離モード" IsChecked="{Binding UseGeographicalRange}" Margin="0,0,0,8"/>
                    <controls:NumberInputControl Label="垂直角" Value="{Binding Angle}" Unit="°" InputWidth="80"/>
                    <controls:NumberInputControl Label="物標高" Value="{Binding Height}" Unit="m" InputWidth="80"/>
                    <controls:NumberInputControl Label="眼高" Value="{Binding HeightOfEye}" Unit="m" InputWidth="80"/>
                </StackPanel>
            </Border>
            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource SextantAccent}" Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="距離" Style="{StaticResource ResultLabel}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DistanceNM, StringFormat={}{0:F2} NM}"
                               Style="{StaticResource ResultHighlight}" Foreground="{DynamicResource SextantAccent}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
