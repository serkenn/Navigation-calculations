<UserControl x:Class="NavCalc.App.Views.Calculators.TimeArc.ArcToTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="弧度→時間" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="Arc to Time" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <controls:NumberInputControl Label="度 (Degrees)" Value="{Binding Degrees}" Unit="°"/>
                    <controls:NumberInputControl Label="分 (Minutes)" Value="{Binding Minutes}" Unit="'"/>
                    <controls:NumberInputControl Label="秒 (Seconds)" Value="{Binding Seconds}" Unit="&quot;"/>
                </StackPanel>
            </Border>

            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource TimeArcAccent}"
                    Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="時間" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ResultHighlight}"
                                   Foreground="{DynamicResource TimeArcAccent}">
                            <Run Text="{Binding ResH, StringFormat={}{0}h}"/>
                            <Run Text="{Binding ResM, StringFormat={}{0}m}"/>
                            <Run Text="{Binding ResS, StringFormat={}{0:F1}s}"/>
                        </TextBlock>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,8"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="10進時" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ResTotalHours, StringFormat={}{0:F4}h}"
                                   Style="{StaticResource ResultValue}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
