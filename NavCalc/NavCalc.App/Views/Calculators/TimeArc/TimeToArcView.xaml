<UserControl x:Class="NavCalc.App.Views.Calculators.TimeArc.TimeToArcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Input -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="時間→弧度" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="Time to Arc" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <controls:TimeInputControl Label="時間 (Time)"
                                               Hours="{Binding Hours}"
                                               Minutes="{Binding Minutes}"
                                               Seconds="{Binding Seconds}"/>
                </StackPanel>
            </Border>

            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource TimeArcAccent}"
                    Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Result -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="弧度" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ResultHighlight}"
                                   Foreground="{DynamicResource TimeArcAccent}">
                            <Run Text="{Binding ResDeg, StringFormat={}{0}°}"/>
                            <Run Text="{Binding ResMin, StringFormat={}{0}'}"/>
                            <Run Text="{Binding ResSec, StringFormat={}{0:F1}&quot;}"/>
                        </TextBlock>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,8"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="10進度" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ResTotalDegrees, StringFormat={}{0:F4}°}"
                                   Style="{StaticResource ResultValue}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
