<UserControl x:Class="NavCalc.App.Views.Calculators.TimeCalc.ToHMSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="時分秒変換" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="To HMS" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <controls:NumberInputControl Label="10進数時間" Value="{Binding DecimalHours}" Unit="h" InputWidth="120"/>
            </Border>
            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource TimeCalcAccent}" Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <TextBlock Style="{StaticResource ResultHighlight}" Foreground="{DynamicResource TimeCalcAccent}">
                    <Run Text="{Binding ResSign}"/>
                    <Run Text="{Binding ResH, StringFormat={}{0}h}"/>
                    <Run Text="{Binding ResM, StringFormat={}{0}m}"/>
                    <Run Text="{Binding ResS, StringFormat={}{0:F1}s}"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
