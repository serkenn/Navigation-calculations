<UserControl x:Class="NavCalc.App.Views.Calculators.TimeCalc.ArithmeticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavCalc.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="四則計算" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Text="Arithmetic" Style="{StaticResource SubHeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <controls:TimeInputControl Label="値A" Hours="{Binding H1}" Minutes="{Binding M1}" Seconds="{Binding S1}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="演算子:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="+" IsChecked="True" GroupName="Op" Checked="OpPlus" Margin="0,0,8,0"/>
                        <RadioButton Content="-" GroupName="Op" Checked="OpMinus" Margin="0,0,8,0"/>
                        <RadioButton Content="x" GroupName="Op" Checked="OpMul" Margin="0,0,8,0"/>
                        <RadioButton Content="÷" GroupName="Op" Checked="OpDiv"/>
                    </StackPanel>

                    <controls:TimeInputControl Label="値B" Hours="{Binding H2}" Minutes="{Binding M2}" Seconds="{Binding S2}"/>
                </StackPanel>
            </Border>

            <Button Content="計算" Style="{StaticResource CalculateButton}"
                    Background="{DynamicResource TimeCalcAccent}" Command="{Binding CalculateCommand}"/>
            <Button Content="クリア" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="計算結果" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ResultHighlight}" Foreground="{DynamicResource TimeCalcAccent}">
                        <Run Text="{Binding ResSign}"/>
                        <Run Text="{Binding ResH, StringFormat={}{0}h}"/>
                        <Run Text="{Binding ResM, StringFormat={}{0}m}"/>
                        <Run Text="{Binding ResS, StringFormat={}{0:F1}s}"/>
                    </TextBlock>
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="10進数" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ResDecimal, StringFormat={}{0:F6} h}"
                                   Style="{StaticResource ResultValue}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
