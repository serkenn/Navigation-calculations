<UserControl x:Class="NavCalc.App.Controls.NumberInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource LabelText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Style="{StaticResource InputTextBox}"
                     Width="{Binding InputWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                     TextAlignment="Right"/>
            <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="13"/>
        </StackPanel>
    </StackPanel>
</UserControl>
