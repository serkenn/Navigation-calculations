<UserControl x:Class="NavCalc.App.Controls.SectionCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardPanel}">
        <StackPanel>
            <!-- Section Title -->
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="0,0,0,12"
                       TextTransform="Uppercase"/>
            <!-- Content -->
            <ContentPresenter Content="{Binding SectionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Border>
</UserControl>
